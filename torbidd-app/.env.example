# Environment Variables Template
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local or any file containing real secrets.

# Node Environment
NODE_ENV=development 

# MongoDB Atlas
# Full Atlas connection string including username, password, and cluster host.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# Database name within the Atlas cluster
MONGODB_DB=torbidd

# ------------------------------------------------------------------------------
# AI-Assisted Classification & Tagging (UC-10)
# ------------------------------------------------------------------------------
# Master switch for AI classification (set false to force rule-based keywords only)
AI_TAGGING_ENABLED=true

# Active AI provider strategy:
#   - google-ai-studio: Google AI Studio Gemini API (uses GEMINI_API_KEY)
#   - vertexai: Google Cloud Vertex AI (uses GOOGLE_CLOUD_PROJECT)
#   - openrouter: OpenRouter API (uses OPENROUTER_API_KEY)
#   - keyword: Deterministic keyword-based classification (offline fallback)
AI_PROVIDER=google-ai-studio

# --- Option 1: Google AI Studio (Gemini) ---
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Option 2: Vertex AI (Google Cloud) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_AI_MODEL=gemini-2.0-flash
VERTEX_AI_MODEL_PRO=gemini-1.5-pro
VERTEX_AI_MODEL_FLASH=gemini-1.5-flash
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Option 3: OpenRouter ---
# Get API key from: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Application
# Public base URL — used for OpenGraph, canonical URLs, and API redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Authentication
# ------------------------------------------------------------------------------
# Create OAuth 2.0 credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 2.4 External Government Data Sources (Continuously polled / received)
# ------------------------------------------------------------------------------
# 1. Open Government Data of Thailand (https://data.go.th / https://opend.data.go.th)
# Register and request an API key at https://opend.data.go.th
GOVSPENDING_API_KEY=
GOVSPENDING_BASE_URL=https://opend.data.go.th/govspending/service/egp-contract
DATA_GO_TH_BASE_URL=https://data.go.th

# 2. Electronic Government Procurement (http://www.gprocurement.go.th / e-GP)
EGP_BASE_URL=https://process5.gprocurement.go.th
EGP_PORTAL_URL=https://www.gprocurement.go.th
EGP_RSS_BASE_URL=https://process3.gprocurement.go.th/EPROCRssFeedWeb/egpannouncerss.xml

# 3. Bangkok Metropolitan Administration e-Procurement (http://egp2.bangkok.go.th)
BMA_BASE_URL=http://egp2.bangkok.go.th

# Ingestion pipeline limits & storage
REQUEST_TIMEOUT_MS=15000
DOCUMENT_STORAGE_PATH=./storage/documents
