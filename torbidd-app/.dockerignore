# Dependencies — rebuilt inside the image
node_modules/
.pnp
.pnp.js

# Source control metadata — never copy into container (ASVS V13.4.1)
.git/
.git*
.svn/
.hg/

# Next.js build output — rebuilt inside the image
.next/
out/

# Environment secrets — NEVER bake into the image (ASVS V13.3.1)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# GCP service account keys
*.json
!package.json
!package-lock.json
!tsconfig.json
!jest.config.js
!jest.setup.js
!eslint.config.mjs
!next.config.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Test artefacts and test suites (DoD: strip tests from image)
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
__tests__/
*.test.*
*.spec.*
tests/

# TypeScript build info cache
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Editor config
.vscode/
.idea/

# Temp
tmp/
temp/
