!package-lock.json
!tsconfig.json
!jest.config.js
!jest.setup.js
!eslint.config.mjs
!next.config.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Test artefacts
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# TypeScript build info cache
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

