# Dependencies — rebuilt inside the image
node_modules/
torbidd-app/node_modules/
.pnp
.pnp.js

# Next.js build output — rebuilt inside the image
.next/
torbidd-app/.next/
out/

# Environment secrets — NEVER bake into the image
.env
.env.local
torbidd-app/.env
torbidd-app/.env.local
*.env

# Git & GitHub
.git/
.github/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Test artefacts
coverage/
torbidd-app/coverage/
.nyc_output/
playwright-report/
test-results/

# TypeScript build info cache
*.tsbuildinfo

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
tmp/
temp/
